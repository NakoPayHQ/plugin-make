{
    "name": "getInvoice",
    "label": "Get Invoice",
    "description": "Retrieve an existing invoice by ID.",
    "type": "action",
    "connection": "nakopay",
    "parameters": [
        { "name": "id", "label": "Invoice ID", "type": "text", "required": true }
    ],
    "url": "https://api.nakopay.com/v1/invoices-get?id={{parameters.id}}",
    "method": "GET",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}",
        "X-NakoPay-Version": "2025-04-20",
        "Accept": "application/json"
    },
    "output": [
        { "name": "id", "label": "Invoice ID", "type": "text" },
        { "name": "status", "label": "Status", "type": "text" },
        { "name": "amount", "label": "Amount", "type": "number" },
        { "name": "currency", "label": "Currency", "type": "text" },
        { "name": "coin", "label": "Coin", "type": "text" },
        { "name": "checkout_url", "label": "Checkout URL", "type": "url" },
        { "name": "paid_at", "label": "Paid At", "type": "date" }
    ]
}
